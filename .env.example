#
# Every secret in the stack, in one place. This file is the committed sample; `just setup`
# copies it to `.env`, which is gitignored and is what actually runs (D-023).
#
#   just setup      # writes .env, generating the five CHANGE_ME values below
#   just dev        # builds and starts everything
#
# Two kinds of value live here, and the difference matters:
#
#   * CHANGE_ME_GENERATED — machine credentials nobody types. `just setup` replaces each with
#     fresh randomness, so no two clones share one and none of them is ever committed.
#   * everything else — configuration, and the four development login passwords. Those are
#     published in README.md as the way to sign in, so hiding them here would be theatre. They
#     are weak on purpose and are safe only because every port binds to 127.0.0.1. Change them
#     before this stack is reachable from anywhere else.
#

# ----------------------------------------------------------------- component versions
POSTGRES_VERSION='16.2'
KEYCLOAK_VERSION='26.5.3'
KEYCLOAK_REGISTRY='quay.io'
OAUTH2_PROXY_VERSION='v7.7.1'

# ----------------------------------------------------------------- the identity provider
# A12Realm and a12-spa-client are the A12 Project Template's own names -- the server's
# client-selfconfiguration hands them to the web application, so renaming them means changing
# both ends.
#
# KEYCLOAK_PUBLIC_URL is the URL the *browser* uses, and therefore the `iss` claim in every
# token: KC_HOSTNAME pins it, so a token minted over the internal `keycloak:8080` address still
# says `localhost:8089` and still validates. Containers use the internal address for their own
# back-channel calls; only this one value has to be reachable from outside.
KEYCLOAK_REALM='A12Realm'
KEYCLOAK_PUBLIC_URL='http://localhost:8089'

# The Keycloak admin console at http://localhost:8089 — administers Keycloak itself, and is not
# one of the realm users below.
KEYCLOAK_ADMIN_USER='admin'
KEYCLOAK_ADMIN_PASSWORD='admin'

# ----------------------------------------------------------------- the realm's users
# Rendered into compose/keycloak/A12Realm-users-0.json, which Keycloak imports on first start.
# Roles come from the realm and map to A12 access rights through import/auth/roles.yaml.
#
# `human` is the person the system works for. `runtime` is the Assistant Runtime's service
# account, with no DOCUMENT_DELETE and no MODEL_MANAGE (D-007). The other three are what the
# end-to-end tier logs in as, and e2e/fixtures/users.json must agree with them.
HUMAN_PASSWORD='human'
RUNTIME_PASSWORD='assistants-runtime-dev'
ADMIN_PASSWORD='A12PT-admintest'
USER1_PASSWORD='A12PT-user1test'
USER2_PASSWORD='A12PT-user2test'

# ----------------------------------------------------------------- databases
# One Postgres container, four databases. The usernames and database names are not secrets and
# are referenced by the healthcheck in compose/docker-compose.yml; the passwords are, and are
# generated. Note they are baked into the Postgres volume on its first start — changing one
# afterwards needs `just clean`, which drops the volume.
DATASERVICES_DB='assistants-ds'
DATASERVICES_USERNAME='assistants-ds-user'
DATASERVICES_PASSWORD='CHANGE_ME_GENERATED'

CONTENTSTORE_DB='assistants-cs'
CONTENTSTORE_USERNAME='assistants-cs-user'
CONTENTSTORE_PASSWORD='CHANGE_ME_GENERATED'

FIREFLY_DB='assistants-firefly'
FIREFLY_DB_USERNAME='assistants-firefly-user'
FIREFLY_DB_PASSWORD='CHANGE_ME_GENERATED'

KEYCLOAK_DATABASE_DB='assistants-keycloak'
KEYCLOAK_DATABASE_USER='assistants-keycloak-user'
KEYCLOAK_DATABASE_PASSWORD='CHANGE_ME_GENERATED'

POSTGRES_PASSWORD='CHANGE_ME_GENERATED'

# ----------------------------------------------------------------- Firefly III (bookkeeping)
# APP_KEY must be `base64:` + 32 random bytes; CRON_TOKEN must be EXACTLY 32 characters.
# `just setup` produces both in the right shape.
FIREFLY_APP_KEY='CHANGE_ME_GENERATED'
FIREFLY_CRON_TOKEN='CHANGE_ME_GENERATED'

# Firefly identifies its user by this address and Keycloak's `human` carries it as `email`, so
# oauth2-proxy's X-Forwarded-Email lands on the same account the Runtime's token belongs to.
# They MUST agree — otherwise the human browses one set of books and the Runtime writes to
# another. There is no Firefly password: Keycloak holds the credential.
FIREFLY_EMAIL='human@localhost'

# The oauth2-proxy that fronts Firefly III. The client secret is rendered into the realm's
# `firefly-oauth2-proxy` client as well, so both ends always agree; the cookie secret encrypts
# the session cookie the proxy sets on the browser and must be exactly 32 bytes.
FIREFLY_PROXY_CLIENT_SECRET='CHANGE_ME_GENERATED'
FIREFLY_PROXY_COOKIE_SECRET='CHANGE_ME_GENERATED'

# ----------------------------------------------------------------- the Runtime
# The timezone every Schedule Trigger's `cron` is read in (ADR-0016). A household means local time
# by "every Monday at nine", so this is one setting for the whole system rather than one per
# Assistant — a household lives in one place.
#
# It is load-bearing twice a year: a 02:30 daily slot happens twice in autumn and not at all in
# spring, and the Runtime resolves the cron to a UTC instant before that instant becomes the
# schedule's identity. Any IANA name works; 'UTC' makes both of those cases unreachable.
SCHEDULE_TIMEZONE='Europe/Berlin'

# The door outward (ADR-0023). The Runtime is the only component that can reach an External System,
# so this is how the *client* asks it something: the server forwards an allowed, read-only Operation
# here and hands the answer back to the browser. Nothing is stored on the way.
#
# The secret is not the User's authentication — that already happened at the server, against
# Keycloak. It is what stops any other container on the compose network calling the door outward.
# The Runtime refuses to start with the port open and no secret set.
#
# The port is published to no host: `runtime` has no `ports:` and gains none. Container-to-container
# traffic on the compose network needs neither `ports` nor `expose`.
RUNTIME_INBOUND_SECRET='CHANGE_ME_GENERATED'

# Which Operations an External Call may name — deployment's half of the gate, and deliberately
# separate from the `clientReadable` flag in the code. That flag says an Operation is *safe* to run
# with no Conversation behind it; this list says we have decided to *offer* it. Both are required,
# and `mutating` Operations are refused whatever this says.
#
# Empty admits nothing, which is the right default for a list that grants access.
CLIENT_CALLABLE_OPERATIONS='bookkeeping.listAccounts,bookkeeping.listTransactions'

# ----------------------------------------------------------------- The letterbox
# The Receptionist's own Gmail account. The User forwards post to it; a Connector turns each message
# into a Document, and the Receptionist is triggered by that Document exactly as it is by one typed
# into the web application. Arrival is translation, so no Assistant runs before a Thing exists.
#
# There are two ways in, and they differ only in the wire. Everything below the credentials — the
# four labels, the allowlist, the poll interval, the caps — is shared, because those are decisions
# about the household and not about a protocol.
#
#   gmail  the Gmail API over an OAuth refresh token. No App Password, no 2FA.
#   imap   IMAP with a Google App Password, which needs 2FA on the account.
#
# Unset, this picks itself: `gmail` when GMAIL_REFRESH_TOKEN is set, `imap` otherwise. Set it only
# to override that.
MAIL_TRANSPORT=''

# --- The Gmail API (MAIL_TRANSPORT=gmail) ---------------------------------------
# **These are the same credentials the sibling `wikai` project already uses** against
# till.gartner@gmail.com. The Google Cloud OAuth app, the consent flow and the refresh token all
# exist already, so there is nothing new to set up — and **no App Password and no 2FA are needed**,
# which is the whole reason this transport exists. Gmail's IMAP requires the
# `https://mail.google.com/` scope; the household's grant does not carry it, and XOAUTH2 against it
# is refused, so IMAP is a dead end here however the credentials are spelled.
#
# The refresh token:
#
#   gog auth tokens export you@gmail.com --out /tmp/gog-token.json   # -> refresh_token
#
# The client id and secret come from gogcli's own credentials.json:
#
#   macOS: ~/Library/Application Support/gogcli/credentials.json
#   Linux: ~/.config/gogcli/credentials.json
#
# GMAIL_USER is the mailbox, and it is used as the API's userId: naming it turns a mismatch between
# the grant and the account into a refusal at the first poll rather than a silent read of the wrong
# letterbox. Empty means "whichever account the refresh token belongs to".
GMAIL_USER=''
GMAIL_CLIENT_ID=''
GMAIL_CLIENT_SECRET=''
GMAIL_REFRESH_TOKEN=''

# --- IMAP (MAIL_TRANSPORT=imap) -------------------------------------------------
# Empty MAIL_HOST means the scan never runs. That is the default and it is not an error — and a
# configured Gmail transport fills it in for itself, so leave it alone unless you are on IMAP.
MAIL_HOST=''
MAIL_PORT='993'
MAIL_USER=''
# A Google **App Password**, which requires 2FA on that account — Google no longer accepts IMAP
# with a normal account password. Never the User's own account password.
MAIL_PASSWORD=''
# Implicit TLS, which is what port 993 is. Only the exact word `false` switches it off, and what that
# buys is **plaintext** — not TLS with the certificate unchecked, which is deliberately not on offer.
# Leave it alone unless the mail server is on a private network: a container inside this stack's own
# compose network, which is what the end-to-end tier points the letterbox at, or a Dovecot on
# localhost. The Runtime names it in the startup line, so a plaintext letterbox is visible.
MAIL_SECURE='true'

# The four Gmail labels — folders over IMAP, label ids over the Gmail API, the same four either way. Every message ends in one of them, so what
# happened to a mail is visible in Gmail without reading a log. Nothing is ever deleted, and nothing
# is ever marked read.
#
#   assistant           not yet handled — the only folder the ingest reads
#   assistants/processed every Document landed
#   assistants/failed    tried, threw, gave up. A real inbox for a human
#   assistants/rejected  sender not on the allowlist. Nothing was read, nothing created
#
# `rejected` exists because the poll takes at most MAIL_MAX_PER_POLL messages: junk left sitting in
# `assistant` would eventually fill every poll and starve a real invoice behind it.
MAIL_FOLDER_INCOMING='assistants'
MAIL_FOLDER_PROCESSED='assistants/processed'
MAIL_FOLDER_FAILED='assistants/failed'
MAIL_FOLDER_REJECTED='assistants/rejected'

# Who may post to the letterbox. **EMPTY MEANS NOBODY.**
#
# A mailbox is the first untrusted input this system has — every other way a Thing comes into being
# involves the User typing. A default that failed open on a public address would turn spam into
# Conversations and LLM spend on the first day it was misconfigured. The Runtime logs the sender
# count at startup, so a misconfigured '0' is visible rather than inferred.
MAIL_ALLOWED_SENDERS=''

# A minute. SCAN_INTERVAL_MS is two seconds, and an IMAP login every two seconds is abusive enough
# that several providers rate-limit or lock the account for it. Household post is not
# latency-sensitive.
MAIL_POLL_INTERVAL_MS='60000'
MAIL_MAX_PER_POLL='20'
MAIL_MAX_ATTACHMENT_BYTES='26214400'

# ----------------------------------------------------------------- Reading a scan
# Reading a PDF that has a text layer is free, exact and automatic. Reading one that has none costs
# money per page, so it is capped twice and it is off unless `llm.json` names a `vision` profile.
# WHICH model does the reading is not here, for the same reason the active model is not here.
#
# Over a cap the Operation reports a reason and never a truncated read: a partial invoice is worse
# than no invoice, because it looks complete.
VISION_MAX_PAGES='10'
VISION_MAX_BYTES='16777216'

# ----------------------------------------------------------------- LLM keys, one per profile
# WHICH model the Assistants talk to is not here — it is `active` in `llm.json`, which `just
# setup` writes from `llm.json.example` and which holds the endpoint, the model and the
# temperature for every configuration by name. Only the secrets live here, because only secrets
# belong in this file.
#
# The variable is named after the profile: `azure_gpt` in `llm.json` reads AZURE_GPT_KEY, and
# adding a profile means adding a line here and nothing else anywhere. Each profile keeps its own
# key, so switching `active` needs no other edit and no key is ever pasted over another.
#
# Nothing below is required to run the stack: the profile shipped active is `scripted`, which
# talks to no one. Fill in the ones you use and delete the rest.
#
# OPENAI_KEY='sk-...'
# ANTHROPIC_KEY='sk-ant-...'
# AZURE_GPT_KEY='...'
# LOCAL_QWEN_KEY='...'
#
# A local server is no exception — an mlx/omlx server answers `API key required` like any other,
# and whatever token it was started with goes here. Only a server that wants none at all gets
# `"requiresKey": false` on its profile instead.

# ----------------------------------------------------------------- images and compose project
# The Gradle docker-compose plugin injects these, but pinning them here means a bare
# `docker compose -f compose/docker-compose.yml --env-file .env up` also works — which is what
# `just` uses, and what anyone debugging the stack will reach for.
# COMPOSE_PROJECT_NAME also makes containers AND volumes share one prefix; without it compose
# derives the project from the directory and the volumes end up named compose_* while the
# containers say assistants_*.
COMPOSE_PROJECT_NAME='assistants'
PROJECT_NAME='assistants'
PROJECT_VERSION='0.1.0'
DOCKER_REGISTRY_FOR_READ='docker.io'
DOCKER_REGISTRY_FOR_PUBLISH='docker.io'
FRONTEND_IMAGE='assistants/frontend:0.1.0'
SERVER_IMAGE='assistants/server:0.1.0'
SERVER_INIT_IMAGE='assistants/server-init:0.1.0'
