# Tools / IDE
.classpath
.project
.settings
.idea
**/*.iml
.vscode/

# Dev configs
**/developer.properties

# Every secret in the stack lives in one file, `.env` at the root, and it is never committed
# (D-023). `.env.example` is, and `just setup` turns it into a working `.env`. Nothing else
# should hold a credential -- if you find one somewhere else, that is a bug.
.env
compose/.env.local

# The same split, for the same reason (D-057): `llm.json.example` is committed so a clone knows
# what a profile looks like, and `llm.json` is the working copy `just setup` writes. It holds no
# secret — it is ignored so that switching model, which is the one line `active`, stays a local
# act rather than a change to the repository.
llm.json

# Rendered from compose/keycloak/*.template by `just render-secrets`, because Keycloak's realm
# import stores `${env.VAR}` literally instead of substituting it (D-023). The templates are
# committed; these outputs carry the passwords and are not.
compose/keycloak/A12Realm-realm.json
compose/keycloak/A12Realm-users-0.json
compose/keycloak/keycloak.env

