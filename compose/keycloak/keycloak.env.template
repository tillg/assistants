# The Keycloak admin console's own account, at http://localhost:8089.
# Distinct from the realm users in A12Realm-users-0.json: this one administers Keycloak,
# those log in to the application.
#
# Rendered from .env by `just render-secrets` -- Keycloak reads this file verbatim and does no
# variable substitution of its own (D-023).
KC_BOOTSTRAP_ADMIN_USERNAME=${KEYCLOAK_ADMIN_USER}
KC_BOOTSTRAP_ADMIN_PASSWORD=${KEYCLOAK_ADMIN_PASSWORD}
