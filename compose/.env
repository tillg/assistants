DATASERVICES_PASSWORD='assistants-ds-pw'

CONTENTSTORE_DB='assistants-cs'
CONTENTSTORE_USERNAME='assistants-cs-user'
CONTENTSTORE_PASSWORD='assistants-cs-pw'

POSTGRES_PASSWORD='assistants-postgres-pw'

# Configuration for Firefly III (bookkeeping)
# Development defaults for the local single-household stack -- not secrets.
# Replace all four before exposing this stack beyond localhost.
FIREFLY_APP_KEY='base64:cDQb4jzTG2kJn6vd6Iabt9GpztMg8xnybhhGgNvzdDU='
FIREFLY_CRON_TOKEN='WT8PkZ4kEQgMdYUPpVFYvo0V9ikpEZWk'
FIREFLY_EMAIL='assistants@localhost'
FIREFLY_PASSWORD='assistants-dev-kLhvK2rkjc10C2CkdVusZCVf'

# Image names and the compose project name.
# The Gradle docker-compose plugin injects these, but pinning them here means a bare
# `docker compose -f compose/docker-compose.yml --env-file compose/.env up` also works —
# which is what `just` uses, and what anyone debugging the stack will reach for.
PROJECT_NAME='assistants'
PROJECT_VERSION='0.1.0'
DOCKER_REGISTRY_FOR_READ='docker.io'
DOCKER_REGISTRY_FOR_PUBLISH='docker.io'
FRONTEND_IMAGE='assistants/frontend:0.1.0'
SERVER_IMAGE='assistants/server:0.1.0'
SERVER_INIT_IMAGE='assistants/server-init:0.1.0'
