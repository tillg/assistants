error_log  /var/log/nginx/error.log debug;
pid        /var/run/nginx.pid;

events {
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer" '
                      '"$http_user_agent" "$http_x_forwarded_for"';

    access_log  /var/log/nginx/access.log  main;

    rewrite_log on;

    sendfile        on;

    gzip            on;
    gzip_vary       on;
    gzip_min_length 10240;
    gzip_types      text/plain text/css application/javascript;

    server {
       listen       8081;
       server_name  localhost;
       client_max_body_size 100M;

       location / {
           root   /var/lib/a12/application/nginx/html;
           index  index.html index.htm;
       }

       location /api/actuator {
            proxy_pass ${NGINX_ASSISTANTS_SERVER_ACTUATOR_URL};
            proxy_redirect off;
            proxy_pass_request_headers on;
       }

       location /api {
            proxy_pass ${NGINX_ASSISTANTS_SERVER_BASE_URL};
            proxy_redirect off;
            proxy_pass_request_headers on;
       }

       # The attachment preview fetches the content store's `/cs/download/<ticket>` for the bytes.
       # The platform advertises that download URL cross-origin (:8082), which CORS blocks and whose
       # `Content-Disposition: attachment` defeats an <iframe src>. Proxying `/cs` here makes it
       # same-origin, so the client reads the bytes with `fetch` and renders them from a blob URL.
       location /cs {
            proxy_pass ${NGINX_ASSISTANTS_SERVER_CONTENTSTORE_URL};
            proxy_redirect off;
            proxy_pass_request_headers on;
       }

    }
}
