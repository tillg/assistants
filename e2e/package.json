{
  "name": "@assistants/e2e",
  "description": "End to end test for Assistants",
  "author": "Till Gartner",
  "license": "EUPL-1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rimraf node_modules .auth test-results playwright-report",
    "e2e:install": "playwright install chromium",
    "test": "playwright test",
    "typecheck": "tsc --noEmit",
    "e2e:test": "playwright test --project=base",
    "e2e:test-flow": "playwright test --project=flow-mail --project=flow-invoice --project=flow-restart",
    "e2e:test-ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "lint": "eslint .",
    "format": "prettier --check \"./*.js\" \"**/*.{ts,tsx}\"",
    "format:fix": "prettier --write \"./*.js\" \"**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.13.0",
    "imapflow": "^1.7.1",
    "moment-timezone": "^0.6.0",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.0",
    "typescript": "^6.0.3"
  }
}
